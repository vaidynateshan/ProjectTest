# --- WhatsApp Business Cloud API credentials -------------------------------
# Copy to .env and fill in. Never commit the filled-in .env.

# Meta App Dashboard > WhatsApp > API Setup > "Temporary access token".
# The temporary one expires in 24h. For anything real, create a System User
# in Business Settings and issue a permanent token with the
# whatsapp_business_messaging and whatsapp_business_management scopes.
WHATSAPP_ACCESS_TOKEN=

# Meta App Dashboard > WhatsApp > API Setup > "Phone number ID".
# This is NOT the phone number itself, and NOT the WhatsApp Business Account ID.
WHATSAPP_PHONE_NUMBER_ID=

# Meta App Dashboard > App Settings > Basic > "App secret".
# Used to verify the X-Hub-Signature-256 header on incoming webhooks.
WHATSAPP_APP_SECRET=

# A string you invent. You type the same value into the Meta dashboard when
# subscribing the webhook; Meta echoes it back during the handshake.
WHATSAPP_VERIFY_TOKEN=

# --- Optional --------------------------------------------------------------
# Graph API version. Pin it deliberately rather than tracking the newest.
WHATSAPP_API_VERSION=v23.0

# Where conversations and downloaded attachments are stored.
WHATSAPP_DB_PATH=whatsapp.db
WHATSAPP_MEDIA_DIR=media
